# Copy this to .env and fill in your key.
# DeepL is optional — without it, the server uses the free MyMemory API.
# Get a free DeepL key: https://www.deepl.com/pro-api (500k chars/month free)

DEEPL_API_KEY=

# Whisper model. Defaults to large-v3 (best quality).
# Faster options: mlx-community/whisper-medium-mlx, mlx-community/whisper-small-mlx
# WHISPER_MODEL=mlx-community/whisper-large-v3-mlx

# Port to serve on
# PORT=8787
