# Copy this to .env (or just `export` these in your shell) before running
# `python3 server/server.py`.
#
# REQUIRED for the live subtitle page:
#   OPENAI_API_KEY  — used by the /realtime WebSocket proxy. Get one at
#                     https://platform.openai.com/api-keys
#                     Cost: ~$0.07/min while subtitling (two parallel
#                     gpt-realtime-translate sessions for bidirectional).

OPENAI_API_KEY=

# OPTIONAL — only used by the legacy convo/meeting modes (not /live):
# DEEPL_API_KEY=
# WHISPER_MODEL=mlx-community/whisper-large-v3-mlx

# Port to serve on. Default 8787.
# PORT=8787
